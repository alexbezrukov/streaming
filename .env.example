# Server Configuration
HTTP_PORT=3000
RTMP_PORT=1935
BIND_ADDR=0.0.0.0
NODE_ID=origin-1
NODE_TYPE=origin
NODE_LOCATION=EU-WEST

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5
REDIS_CLUSTER=false
REDIS_KEY_PREFIX=stream:

# CDN Configuration
CACHE_SIZE=10000
SEGMENT_TTL=300
MAX_NODE_CAPACITY=5000
ENABLE_EDGE_CACHE=true
ENABLE_STATS=true
# ORIGIN_URL=http://origin-server:3000  # For edge nodes

# Load Balancing
LOAD_BALANCING_STRATEGY=least-connections  # Options: least-connections, geographic, weighted, round-robin, random
HEARTBEAT_TIMEOUT=30
MAX_LOAD_PERCENTAGE=90.0

# Streaming Configuration
HLS_SEGMENT_DURATION=6
HLS_PLAYLIST_SIZE=10
ENABLE_DASH=true
ENABLE_WEBRTC=true
DVR_WINDOW=60
ENABLE_ABR=true